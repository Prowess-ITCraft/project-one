# Copy to .env and fill every value. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet key:             python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

P1_ENV=dev
P1_VERSION=dev
P1_PUBLIC_BASE_URL=http://localhost:9597
# Production proxy: prod (HTTPS with a certificate in infra/nginx/tls) or conf.d (plain HTTP
# behind a load balancer that terminates TLS). Ignored in development.
P1_PROXY_CONF=prod

P1_POSTGRES_PASSWORD=
P1_OWNER_PASSWORD=
P1_APP_PASSWORD=
P1_REDIS_PASSWORD=
P1_S3_ACCESS_KEY=
P1_S3_SECRET_KEY=
P1_GRAFANA_PASSWORD=

# Comma separated lists. The first key signs or encrypts, the others only verify or decrypt
# (this is how key rotation works).
P1_FERNET_KEYS=
P1_JWT_SIGNING_KEYS=

P1_COOKIE_SECURE=false
P1_CORS_ALLOW_ORIGINS=http://localhost:9595,http://localhost:9597
P1_S3_PUBLIC_ENDPOINT_URL=http://localhost:9601

# Optional
# The API reference at /docs. Set false to hide it on a server open to the internet.
P1_API_DOCS=true
P1_SENTRY_DSN=
P1_OTEL_EXPORTER_OTLP_ENDPOINT=

# Email for OTPs and notifications. Leave the host empty to disable sending (messages are logged as skipped).
# In dev the compose file points this at Mailpit (http://localhost:9605).
P1_SMTP_HOST=
P1_SMTP_PORT=587
P1_SMTP_USER=
P1_SMTP_PASSWORD=
P1_SMTP_FROM=no-reply@itcraft.example
P1_SMTP_STARTTLS=true

# Document corpus (ADR 0014). 0 keeps original library files forever. A positive number deletes
# originals older than that many days, after their canonical JSON is verified. Irreversible.
P1_CORPUS_ORIGINALS_RETENTION_DAYS=0
