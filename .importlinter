[importlinter]
root_package = app
include_external_packages = False

# Modules talk to each other only through contracts.py (or events via the outbox).
[importlinter:contract:module-boundaries]
name = Modules import other modules only through contracts
type = forbidden
source_modules =
    app.modules.audit_log
    app.modules.identity
    app.modules.customers
    app.modules.files
    app.modules.prismsuite
    app.modules.catalogue
    app.modules.datasets
    app.modules.infra
    app.modules.boq
    app.modules.planning
    app.modules.notifications
    app.modules.fieldops
    app.modules.verification
    app.modules.reporting
    app.modules.ml
forbidden_modules =
    app.modules.audit_log.models
    app.modules.audit_log.service
    app.modules.identity.models
    app.modules.identity.service
    app.modules.identity.repository
    app.modules.customers.models
    app.modules.customers.service
    app.modules.files.models
    app.modules.files.service
    app.modules.prismsuite.models
    app.modules.prismsuite.service
    app.modules.catalogue.models
    app.modules.catalogue.service
    app.modules.datasets.models
    app.modules.datasets.service
    app.modules.infra.models
    app.modules.infra.service
    app.modules.boq.models
    app.modules.boq.service
    app.modules.planning.models
    app.modules.planning.service
    app.modules.notifications.models
    app.modules.notifications.service
    app.modules.fieldops.models
    app.modules.fieldops.service
    app.modules.verification.models
    app.modules.verification.service
    app.modules.reporting.models
    app.modules.reporting.service
    app.modules.ml.models
    app.modules.ml.service
allow_indirect_imports = True
ignore_imports =
    app.modules.audit_log.** -> app.modules.audit_log.**
    app.modules.identity.** -> app.modules.identity.**
    app.modules.customers.** -> app.modules.customers.**
    app.modules.files.** -> app.modules.files.**
    app.modules.prismsuite.** -> app.modules.prismsuite.**
    app.modules.catalogue.** -> app.modules.catalogue.**
    app.modules.datasets.** -> app.modules.datasets.**
    app.modules.infra.** -> app.modules.infra.**
    app.modules.boq.** -> app.modules.boq.**
    app.modules.planning.** -> app.modules.planning.**
    app.modules.notifications.** -> app.modules.notifications.**
    app.modules.fieldops.** -> app.modules.fieldops.**
    app.modules.verification.** -> app.modules.verification.**
    app.modules.reporting.** -> app.modules.reporting.**
    app.modules.ml.** -> app.modules.ml.**
    app.modules.**.tests.** -> app.modules.**

[importlinter:contract:core-is-independent]
name = core never imports a module
type = forbidden
source_modules = app.core
forbidden_modules = app.modules
